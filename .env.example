# IndexNow (zie docs/indexnow.md): geen van beide is verplicht.
# INDEXNOW_KEY overschrijft de gecommitte standaardsleutel (public/<key>.txt) -
# alleen zetten als je roteert, en dan ALTIJD samen met een nieuw
# public/<nieuwe-sleutel>.txt-bestand.
INDEXNOW_KEY=
# INDEXNOW_TRIGGER_SECRET: server-only secret voor POST /api/indexnow/submit.
# Zonder deze variabele is die route uitgeschakeld (503).
INDEXNOW_TRIGGER_SECRET=
